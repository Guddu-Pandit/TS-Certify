# ---------------------------------------------------------------------------
# TS-Certify environment
# Copy to .env.local and fill REAL values in there. This file is COMMITTED and
# must stay blank — .env.local is the gitignored one that holds secrets.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key. Server-only. Bypasses RLS entirely — never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site -----------------------------------------------------------------
# Baked permanently into every QR code. Must be the real public origin in
# production (https://your-app.vercel.app), or issued certificates have dead QRs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Sheets (service account, read-only) ---------------------------
# From the service account JSON key: client_email
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# From the same JSON: private_key. Keep it on ONE line, in double quotes, with
# literal \n sequences. On Vercel, paste it with real newlines instead.
GOOGLE_PRIVATE_KEY=""
# From the Sheet URL: /spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
# The response tab name, usually "Form Responses 1"
GOOGLE_SHEET_TAB=Form Responses 1

# --- Gmail SMTP -----------------------------------------------------------
GMAIL_USER=
# 16-character App Password with the spaces REMOVED. Requires 2-Step
# Verification to be enabled on the Google account first.
GMAIL_APP_PASSWORD=

# --- Certificates ---------------------------------------------------------
# Certificate IDs look like <PREFIX>-<YEAR>-0001
CERT_ID_PREFIX=TS
# Printed on certificates and used in emails as {{orgName}}
ORG_NAME=TS Certify

# --- Cron -----------------------------------------------------------------
# Any long random string. Sent as `Authorization: Bearer <this>` by the Vercel
# cron job so /api/cron/sync cannot be triggered by the public.
CRON_SECRET=
